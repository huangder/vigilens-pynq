# buildroot_w7.config —— Buildroot 2025.02.x 的 W7 增量配置（配合 support/kconfig/merge_config.sh）
#
# ⚠️ 【未在真实 Buildroot 上验证过】每一条都对应 docs/41 §5 的一个理由；
#    跑 `make olddefconfig` 之后脚本会 grep 回读，**别盲信这份文件**。
#
# 用法（在 buildroot 源码根）：
#   support/kconfig/merge_config.sh -m .config ../../path/to/buildroot_w7.config
#   make olddefconfig

# ---- 基本 ----
# zynq_zed_defconfig 会把这一条设成 y ⇒ 自定义版本也必须能在 .hash 里查到条目，
# 否则报 `ERROR: No hash found for u-boot-2024.10.tar.bz2`。关掉它才能用不在 .hash 里的版本。
# BR2_DOWNLOAD_FORCE_CHECK_HASHES is not set
BR2_TARGET_GENERIC_HOSTNAME="mizar"
BR2_TARGET_GENERIC_ISSUE="VigiLens W7 (Mizar-Z7 7020)"
BR2_TARGET_GENERIC_ROOT_PASSWD="root"

# ---- 串口控制台：Zynq 的 PS UART1 = ttyPS0（DTS 里 aliases.serial0 已指向它）----
# 少了这三条，板子能启动但**没有登录提示符**，会被误判成"内核没起来"
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyPS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y

# ---- 文件系统：只要 ext4（p2）----
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="512M"
BR2_TARGET_ROOTFS_TAR=n

# ---- 内核：mainline 6.6.158 + multi_v7（不用 Xilinx 内核分支：它的 tarball 在 github 上，
#      这台机器 github 被 DNS 指到 127.0.0.1，根本下不动 —— 2026-10-25 实测）----
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.6.158"
BR2_LINUX_KERNEL_USE_DEFCONFIG=y
# ⚠️ 2025.02 + 内核 6.x 的 xilinx_zynq_defconfig 已不保证存在，改用 multi_v7
#    （Zynq-7000 在 ARCH_ZYNQ=y 里被 multi_v7 覆盖；代价是内核更大、编译更久）
BR2_LINUX_KERNEL_DEFCONFIG="multi_v7"
# 设备树**不由内核编**：dtb 来自 Windows 侧 sdtgen + 我们自己的 dts 流程（docs/41 §17），
# 上板时由 boot.cmd 从卡里 load。这样也躲开"mainline 把 zynq dts 挪进 dts/xilinx/ 子目录"的路径问题。
# BR2_LINUX_KERNEL_DTS_SUPPORT is not set
# BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES 由 wsl_build.sh 用 sed 填成绝对路径

# ---- U-Boot：bootgen 要的是 **ELF**，不是 u-boot.img；且不要 SPL（DDR 由我们的 FSBL 初始化）----
BR2_TARGET_UBOOT=y
# 同上：默认 defconfig 选的是 Xilinx 分支（github tarball），改成 mainline 2024.10
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2024.10"
# 2025.02 的 zynq_zed_defconfig 会选 xilinx_zynq_virt（QEMU 虚拟板）——板上跑要显式改回 zynq_zed
BR2_TARGET_UBOOT_BOARD_DEFCONFIG="xilinx_zynq_virt"
BR2_TARGET_UBOOT_FORMAT_ELF=y
# BR2_TARGET_UBOOT_SPL is not set

# ---- 板上要有的工具 ----
# ⚠️ v4l-utils（v4l2-ctl）在 2025.02 里依赖 BR2_INSTALL_LIBSTDCPP，而这个符号**只由外部工具链 select**
#    （内部 buildroot 工具链不会设它，2026-10-25 实测：写了也会被 olddefconfig 丢掉）
#    ⇒ 板子上没有 v4l2-ctl，验证 UVC 用 dmesg + lsusb + /dev/video0（docs/41 §22.3）
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_DROPBEAR=y
# usbutils（lsusb）要 udev（BR2_PACKAGE_HAS_UDEV），我们用 devtmpfs ⇒ 装不上；
# 板上一律用 `dmesg | grep -i usb` + `ls /dev/video*` + `cat /sys/class/video4linux/*/name` 验证
BR2_PACKAGE_DROPBEAR=y
BR2_PACKAGE_LIBUSB=y
BR2_PACKAGE_USBUTILS=y

# ---- 精简（先不装 python：板上不跑 mediapipe）----
BR2_PACKAGE_PYTHON3=n

# MJPG -> RGB on PS for the direct-camera PL bring-up profile.
BR2_PACKAGE_JPEG=y
BR2_PACKAGE_JPEG_TURBO=y

# ---- 内核镜像格式：要 zImage（boot.cmd 用 bootz），不要 uImage ----
BR2_LINUX_KERNEL_ZIMAGE=y
# BR2_LINUX_KERNEL_UIMAGE is not set

# ---- 关掉 zynq_zed_defconfig 带的 genimage post-image 脚本 ----
# 它要求 images/boot.bin（U-Boot SPL 的 boot.bin），而我们的引导链是
#   BootROM → mini_fsbl（自己 bootgen 出的 BOOT.BIN）→ u-boot
# 不需要它，留着只会报：
#   ERROR: file(boot.bin): stat(.../images/boot.bin) failed: No such file or directory
BR2_ROOTFS_POST_IMAGE_SCRIPT=""
