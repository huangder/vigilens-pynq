#   data/fatigue_db/schema.sql（库结构，供评审查表）。
# **不入库**：
#   · 年龄模型权重（体积大、许可见模型页，用 metrics/scripts/fetch_age_model.py 取）；
#   · SQLite 库本体 —— 它含**个体测量数据与人脸签名**（虽是不可逆签名，仍属个人信息）。
data/models/age/
data/fatigue_db/*.sqlite3
data/fatigue_db/*.sqlite3-wal
data/fatigue_db/*.sqlite3-shm

