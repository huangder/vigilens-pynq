# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
# pytest 在受限沙箱/受限 ACL 下会遗留"建得出来但列不出、删不掉"的目录
# （WinError 5）。它们没有任何内容价值，忽略掉以免 git 去遍历。
pytest-cache-files-*/

# ---- A 线：4 段标准测试视频（体积大，默认不入库）----------------------------
# 想连视频一起入库，把下面 4 行注释掉即可（前提：单个文件 < 50 MB）。
# > 100 MB 的文件 GitHub 会直接拒绝推送；那种情况请用 Releases 附件或 Git LFS，
# 不要改这里的规则硬塞。放好视频后跑：python backend/run_pipeline.py --source data/raw/xxx.mp4
data/raw/*.mp4
data/raw/*.avi
data/raw/*.mov
data/raw/*.mkv

# ---- A 线：大体积黄金帧序列（可由脚本确定性重建）----------------------------
data/raw/*.bin

# ---- 运行时产物（代码生成，不入库；目录靠 .gitkeep 保留）--------------------
metrics/csv/*.csv
metrics/logs/*.json
metrics/logs/*.jsonl
metrics/logs/*.log
metrics/logs/*.tmp
# metrics/logs/ 是**生成物**目录（`metrics/csv/*.csv` 已经这样处理了）：A 线管线/演示脚本
# 在这里落的契约指标 CSV（如 demo_clip.csv / demo_face.csv）同理不入库。
# ⚠️ 正式证据仍然走 metrics/evidence/（那一条不要加更宽的通配，见下面的注意事项）。
metrics/logs/*.csv
metrics/evidence/*.tmp
# ⚠️ BUG-003：上面这条 `metrics/logs/*.tmp` 是补的（2026-10-01）。
#    原来只有 `metrics/evidence/*.tmp`，而实际脏掉 git status 的临时文件**产生在 metrics/logs/**
#    （`tempfile` 在 A 线管线/演示脚本运行期落到那里，形如 tmp_bz04xar.tmp）——
#    于是"每次 git status 都是脏的"。台账 BUG-003 描述的现象与这里对得上。
# 📌 BUG-003 的**根因**另有一条（本行修不了）：`tempfile.gettempdir()` 在本机解析到一个
#    被写入拒绝的目录，才导致产物落到 metrics/logs/。真正该做的是修 TEMP 或让脚本显式指定
#    产物目录；本行只保证"不再脏 git status"。

# HLS 构建失败标记（vitis-run 会在 fpga/ 下留一个 .hls.failed）
fpga/.hls.failed

# ---- A 线：年龄分层疲劳功能的产物（docs/28）--------------------------------
