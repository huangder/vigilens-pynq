fpga/sim/data/frames.bin

# ---- cosim 专用小尺寸向量（一键重建，见 fpga/README.md「跑 cosim」）----
fpga/sim/data_small/
fpga/sim/data_motion_small/
fpga/sim/data_fir_small/

# ---- C 线：rgb2gray / motion_quality 的生成向量 -----------------------------
# 一键重建：python fpga/sim/gen_motion_vectors.py
# 注意：fpga/sim/data_motion/{meta.txt, golden_motion.csv} 是黄金参考，必须入库（不要忽略）。
fpga/sim/data_motion/rgb_frames.bin
fpga/sim/data_motion/gray.bin

# ---- C 线：fir_filter 的生成向量 -------------------------------------------
# 一键重建：python fpga/sim/gen_fir_vectors.py
# 注意：fpga/sim/data_fir/{meta.txt, golden_fir.csv, golden_fir_out.csv}
#       是黄金参考，**必须入库**（golden_fir_out.csv 是逐样本期望输出，可人工评审）。
fpga/sim/data_fir/series.bin

# ---- C 线：fir_filter 的 60 Hz 档系数与向量（docs/22 §2）--------------------
# 系数表 fpga/src/fir_coeffs_q15_60hz.h 由 design_fir_coeffs.py 生成，**必须入库**；
# 黄金参考：python fpga/sim/gen_fir_vectors.py --header fpga/src/fir_coeffs_q15_60hz.h \
#                                             --out-dir fpga/sim/data_fir_60hz
# 注意：fpga/sim/data_fir_60hz/{meta.txt, golden_fir.csv, golden_fir_out.csv} 必须入库。
fpga/sim/data_fir_60hz/series.bin

# ---- C 线：v1.5 测量口径档位的生成向量（docs/interface.md 头部 v1.5 草案）----
# 720p 档（抽取 3/8 -> 480x270）：
#   python fpga/sim/gen_motion_vectors.py --width 1280 --height 720 --decim 3 8 \
#          --out-dir fpga/sim/data_motion_720p
# 1080p 档（抽取 1/4 -> 480x270）：同上，改 --width 1920 --height 1080 --decim 1 4
# 注意：fpga/sim/data_motion_720p/{meta.txt, golden_motion.csv} 是黄金参考，**必须入库**。
fpga/sim/data_motion_720p/rgb_frames.bin
fpga/sim/data_motion_720p/gray.bin

# ---- C 线：raw10_unpack / bayer_demosaic 的生成向量（docs/19 新像素源链路）----
# 一键重建：python fpga/sim/gen_mipi_vectors.py
# 注意：fpga/sim/data_mipi/{meta.txt, golden_mipi.csv} 是黄金参考，**必须入库**
#       （golden_mipi.csv 是逐帧抽查点，可人工评审；全量黄金参考是 .bin，体积大且可重建）。
fpga/sim/data_mipi/raw10.bin
fpga/sim/data_mipi/golden_bayer16.bin
fpga/sim/data_mipi/golden_rgb.bin

# ---- C 线：frame_scale 的生成向量（docs/20 的 720p60 方案）-------------------
# 一键重建：python fpga/sim/gen_scale_vectors.py
# 注意：fpga/sim/data_scale/{meta.txt, golden_scale.csv} 是黄金参考，**必须入库**。
fpga/sim/data_scale/rgb_in.bin
fpga/sim/data_scale/golden_scale.bin

# ---- Vitis HLS 构建产物 ----------------------------------------------------
fpga/component_*/
fpga/logs/
*.aps
*.protoinst

# ---- 官方例程参考克隆（用 README 里的命令重新拉取，不作为本仓内容）----------
fpga/examples/Vitis-HLS-Introductory-Examples/

# ---- Python ----------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
# pytest 在受限沙箱/受限 ACL 下会遗留"建得出来但列不出、删不掉"的目录
# （WinError 5）。它们没有任何内容价值，忽略掉以免 git 去遍历。
pytest-cache-files-*/

# ---- A 线：4 段标准测试视频（体积大，默认不入库）----------------------------
# 想连视频一起入库，把下面 4 行注释掉即可（前提：单个文件 < 50 MB）。
# > 100 MB 的文件 GitHub 会直接拒绝推送；那种情况请用 Releases 附件或 Git LFS，
# 不要改这里的规则硬塞。放好视频后跑：python backend/run_pipeline.py --source data/raw/xxx.mp4
data/raw/*.mp4
data/raw/*.avi
data/raw/*.mov
data/raw/*.mkv

# ---- A 线：大体积黄金帧序列（可由脚本确定性重建）----------------------------
data/raw/*.bin

# ---- 运行时产物（代码生成，不入库；目录靠 .gitkeep 保留）--------------------
metrics/csv/*.csv
metrics/logs/*.json
metrics/logs/*.jsonl
metrics/logs/*.log
metrics/logs/*.tmp
# metrics/logs/ 是**生成物**目录（`metrics/csv/*.csv` 已经这样处理了）：A 线管线/演示脚本
# 在这里落的契约指标 CSV（如 demo_clip.csv / demo_face.csv）同理不入库。
# ⚠️ 正式证据仍然走 metrics/evidence/（那一条不要加更宽的通配，见下面的注意事项）。
metrics/logs/*.csv
metrics/evidence/*.tmp
# ⚠️ BUG-003：上面这条 `metrics/logs/*.tmp` 是补的（2026-10-01）。
#    原来只有 `metrics/evidence/*.tmp`，而实际脏掉 git status 的临时文件**产生在 metrics/logs/**
#    （`tempfile` 在 A 线管线/演示脚本运行期落到那里，形如 tmp_bz04xar.tmp）——
#    于是"每次 git status 都是脏的"。台账 BUG-003 描述的现象与这里对得上。
# 📌 BUG-003 的**根因**另有一条（本行修不了）：`tempfile.gettempdir()` 在本机解析到一个
#    被写入拒绝的目录，才导致产物落到 metrics/logs/。真正该做的是修 TEMP 或让脚本显式指定
#    产物目录；本行只保证"不再脏 git status"。

# HLS 构建失败标记（vitis-run 会在 fpga/ 下留一个 .hls.failed）
fpga/.hls.failed

# ---- A 线：年龄分层疲劳功能的产物（docs/28）--------------------------------
# **必须入库**（不要在上面加通配）：data/reference/age_bands.json（带出处的参照基线）、
#   data/fatigue_db/schema.sql（库结构，供评审查表）。
# **不入库**：
#   · 年龄模型权重（体积大、许可见模型页，用 metrics/scripts/fetch_age_model.py 取）；
#   · SQLite 库本体 —— 它含**个体测量数据与人脸签名**（虽是不可逆签名，仍属个人信息）。
data/models/age/
data/fatigue_db/*.sqlite3
data/fatigue_db/*.sqlite3-wal
data/fatigue_db/*.sqlite3-shm

# 自检/临时脚本产物（下划线开头 = 本机临时，不是证据，不入库）
metrics/logs/_*
metrics/evidence/_pytest_tmp/
metrics/evidence/_*
# ⚠️ 注意：metrics/evidence/ 下**正式证据**（如 a_line_m1_run.json、js_frames.jsonl、
#    页面截图 B8）是要入库的，不要在上面加更宽的通配把它一起忽略掉。

